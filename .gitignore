# ------------------------------------------------------------
#  Nicht ins Repo: lokale Geheimnisse & generierte Dateien
# ------------------------------------------------------------

# Vom Setup erzeugt (enthält den geheimen Pfad / Hash)
nginx/secret.conf

# Altlasten aus früheren Versionen (werden nicht mehr benötigt)
.env
.env.*
nginx/.htpasswd

# Zertifikate (HTTPS) und Let's-Encrypt/lego-Daten
# (lego/ enthält das ACME-Konto und die privaten Schlüssel!)
certs/
nginx/certs/
lego/
*.pem
*.key
*.crt

# Lokale Backups / Zwischenstände (z. B. docker-compose.yml.bak.*)
*.bak
*.bak.*

# n-gram-Daten: sehr groß (mehrere GB), wird vom Setup geladen
# (enthält auch die Auswahl in ngrams/.languages)
ngrams/

# Logs und Betriebssystem-Kram
*.log
.DS_Store
Thumbs.db
