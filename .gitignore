# ------------------------------------------------------------
#  Not for repo: local secrets & generated files
# ------------------------------------------------------------

# .env with credentials/secrets
.env
.env.*
!.env.example

# Generated by setup.sh (contains secret path)
nginx/.htpasswd
nginx/secret.conf

# Certificates (HTTPS)
nginx/certs/
*.pem
*.key

# n-gram data: large (several GB), downloaded by setup
ngrams/

# Logs and OS files
*.log
.DS_Store
Thumbs.db
