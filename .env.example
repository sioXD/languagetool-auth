# ============================================================
#  LanguageTool + nginx Basic Auth – Konfiguration
# ============================================================
#
#  Diese Datei nach .env kopieren bzw. anpassen:
#    cp .env.example .env
#
#  WICHTIG für Passwörter: keine Doppelpunkte (:), Kommas (,),
#  @ / und keine Leerzeichen verwenden, sonst muss man sie in
#  der Extension-URL prozent-encodieren.
# ============================================================

# ------------------------------------------------------------
#  Benutzer für Basic Auth
# ------------------------------------------------------------
#  Format:  benutzer1:passwort1,benutzer2:passwort2
#   - Trenner zwischen zwei Benutzern ist das KOMMA
#   - Trenner zwischen Benutzer und Passwort ist der DOPPELPUNKT
#  Beliebig viele Benutzer möglich. Alle haben vollen Zugriff
#  auf dieselbe LanguageTool-Instanz.
#
#  Beispiel mit einem Benutzer:
LT_USERS="simon:supersicheres_passwort"
#
#  Beispiel mit mehreren Benutzern:
#  LT_USERS="simon:passwort1,anna:passwort2,ben:passwort3"

# ------------------------------------------------------------
#  Öffentlicher Port, über den LanguageTool erreichbar sein soll.
#  Muss identisch mit dem Port in nginx/nginx.conf sein.
# ------------------------------------------------------------
PUBLIC_PORT=8082